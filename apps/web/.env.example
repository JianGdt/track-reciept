NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the private key quoted, with literal \n between PEM lines.
FIREBASE_PRIVATE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Comma-separated extra web origins, if needed.
BETTER_AUTH_TRUSTED_ORIGINS=

# Private S3-compatible photo storage (Tigris free-tier example).
S3_ENDPOINT=https://t3.storage.dev
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Used once on transient model errors/timeouts.
GEMINI_FALLBACK_MODEL=gemini-3.7-flash
